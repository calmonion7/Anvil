{
  "name": "anvil",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite dev",
    "dev:web": "node scripts/dev-web.js",
    "dev:app": "node scripts/dev-app.js",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:app": "playwright test -c playwright.app.config.ts",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
